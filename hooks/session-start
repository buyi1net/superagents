#!/usr/bin/env bash
# constitution SessionStart hook —— 开场把全局规则总纲注入 agent 上下文。
# Claude Code 和 codex 共用(两家 SessionStart 都读 hookSpecificOutput.additionalContext)。
# 靠脚本自身位置定位 plugin 内的 SKILL.md,不写死绝对路径 —— 换机随 plugin 走。

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
SKILL_MD="${PLUGIN_ROOT}/skills/constitution/SKILL.md"

content=$(cat "${SKILL_MD}" 2>&1 || echo "Error: 读取 constitution SKILL.md 失败")

# JSON 转义:bash 参数替换,每步单遍 C 级替换,比逐字符循环快得多。
# 顺序要紧:反斜杠必须最先转,否则后面新增的反斜杠会被二次转义。
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$content")
ctx="<EXTREMELY_IMPORTANT>\n以下是你的全局规则总纲 constitution,本对话全程必须遵守;其中每处「详见 modules/X」都是强制读取,不是可选参考。\n\n${escaped}\n</EXTREMELY_IMPORTANT>"

# Claude Code 和 codex 的 SessionStart hook 都读 hookSpecificOutput.additionalContext(嵌套)。
# 用 printf 不用 heredoc,绕开 bash 5.3+ 的 heredoc 挂起 bug。
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$ctx"

exit 0
